{
    "entryPoints": ["@oxylus/*/src/**/index.ts"],
    "entryPointStrategy": "expand",
    "out": "docs/api/ts",
    "exclude": ["**/*.spec.ts", "**/*.test.ts"],
    "externalPattern": ["**/*.spec.ts", "**/*.test.ts"],
    "excludeExternals": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "includeVersion": true,
    "hideGenerator": true,
    "theme": "markdown",
}
