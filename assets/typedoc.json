{
    "entryPoints": [
        "packages/ox/src/lib.ts",
        "packages/*/src/composables/index.ts",
        "packages/*/src/composables.ts",
        "packages/*/src/models/index.ts",
        "packages/*/src/models.ts",
        "packages/*/src/index.ts"
    ],
    "entryPointStrategy": "expand",
    "out": "docs/api/",
    "exclude": ["**/*.spec.ts", "**/*.test.ts"],
    "externalPattern": ["**/*.spec.ts", "**/*.test.ts"],
    "excludeExternals": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "includeVersion": true,
    "hideGenerator": true,
    "hideBreadcrumbs": true,
    "theme": "markdown",
    "plugin": ["typedoc-plugin-markdown"]
}
