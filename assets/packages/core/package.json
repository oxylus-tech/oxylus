{
  "name": "@oxylus/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec vite",
    "build": "pnpm exec vite build --mode lib && pnpm exec vite build",
    "watch": "pnpm exec vite build --watch",
    "preview": "pnpm exec vite preview",
    "test": "pnpm exec vitest",
    "coverage": "pnpm exec vitest run --coverage",
    "docs:vue": "pnpm exec vue-styleguidist build",
    "docs:ts": "pnpm exec typedoc --out ../docs/ts --tsconfig tsconfig.json src"
  },
  "files": ["src/"],
  "exports": {
    "./index": "./src/index.ts"
  },
  "dependencies": {
    "@oxylus/ox": "workspace:*"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
