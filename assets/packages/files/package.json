{
  "name": "@oxylus/files",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec vite",
    "build": "pnpm exec vite build",
    "watch": "pnpm exec vite build --watch",
    "preview": "pnpm exec vite preview",
    "test": "pnpm exec vitest",
    "coverage": "pnpm exec vitest run --coverage",
    "docs:vue": "pnpm exec vuedoc-md src/components --out ../docs/vue",
    "docs:ts": "pnpm exec typedoc --out ../docs/ts --tsconfig tsconfig.json src"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "exports": {
    "./index": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./composables": "./src/composables.ts",
    "./models": "./src/models.ts"
  },
  "dependencies": {
    "@oxylus/ox": "workspace:*",
    "@oxylus/auth": "workspace:*",
    "@oxylus/content": "workspace:*",
    "vuetify": "^3.8.3"
  }
}
